{
  "status": "draft_not_frozen",
  "created_date": "2026-09-30",
  "frozen_evaluation_used": false,
  "systems": {
    "presidio": {
      "mode": "presidio",
      "description": "Presidio-only structured PII baseline"
    },
    "gliner": {
      "mode": "gliner",
      "description": "GLiNER-only contextual PII detector"
    },
    "hybrid": {
      "mode": "hybrid",
      "description": "Presidio plus GLiNER with shared overlap resolution"
    }
  },
  "label_mapping": {
    "path": "configs/label_mapping.json",
    "version": "safepaste-label-mapping-v1",
    "target_labels": [
      "ADDRESS",
      "EMAIL",
      "FINANCIAL",
      "GOVERNMENT_ID",
      "IP_ADDRESS",
      "PERSON",
      "PHONE"
    ]
  },
  "presidio": {
    "source": "presidio",
    "nlp_engine": "NoOpNlpEngine",
    "custom_recognizers": [
      "SafePasteSingaporeNricRecognizer",
      "SafePasteSingaporePhoneRecognizer",
      "SafePasteSingaporeUnitRecognizer",
      "SafePasteSingaporePostalCodeRecognizer"
    ]
  },
  "gliner": {
    "model_repo": "urchade/gliner_multi_pii-v1",
    "model_path_env": "SAFEPASTE_GLINER_MODEL",
    "local_files_only": true,
    "typed_threshold": null,
    "abstain_threshold": null,
    "threshold_grid": {
      "typed_threshold": [0.45, 0.50, 0.55, 0.60, 0.65, 0.70],
      "abstain_threshold": [0.20, 0.25, 0.30, 0.35, 0.40]
    }
  },
  "evaluation": {
    "boundary_metrics": ["exact", "overlap"],
    "prediction_types": ["typed", "protective"],
    "typed_metrics_require_label_match": true,
    "protective_metrics_include_abstained": true,
    "matching": "one_to_one"
  },
  "next_required_step": "Run full development threshold sweep and replace null GLiNER thresholds before creating configs/final_experiment.json."
}
